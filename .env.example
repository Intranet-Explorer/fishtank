# Shared secret for worldd, the viewer, the fish, and the fetch proxy.
# Generate your own. Never commit .env.
WORLD_TOKEN=change-me-to-a-long-random-string

# worldd (host process — serves API + the glass)
WORLD_HOST=127.0.0.1
WORLD_PORT=8080
WORLD_URL=http://127.0.0.1:8080
SCAN_INTERVAL_SEC=3

# Fetch proxy (host process)
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
FETCH_PROXY=http://127.0.0.1:8787

# Local MLX server (Metal on the Mac — never in Docker)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
OPENAI_API_KEY=local

# Fish
HEARTBEAT_SEC=5
MAX_TOOLS_PER_WAKE=48
# Per-request generation cap (mlx_lm.server default is 512 — too small for tool JSON).
MAX_TOKENS=2048
# HTTP client wait for /v1/chat/completions. Longer wakes share one MLX.
LLM_TIMEOUT_SEC=180
# Shell tool inside the fish container.
RUN_TIMEOUT_SEC=120
# 1 = skip the model (glass still moves). mac-up.sh sets this if MLX is down.
DUMMY=0

# worldd file caps (bytes)
MAX_READ_BYTES=32000000
MAX_WRITE_BYTES=32000000

# Fetch proxy (GET only)
FETCH_MAX_BYTES=10000000
FETCH_TIMEOUT_SEC=60

# Docker fish talk to host services through host.docker.internal
# (compose overrides WORLD_URL / OPENAI_BASE_URL / FETCH_PROXY)
#
# docker-compose.yml mem_limit is 3.5g per fish so two fish fit a ~8GB
# Docker Desktop VM. Raise Docker Desktop RAM before bumping mem_limit.

# When you add a cloud model later: set a daily spend cap on that account.
# Do not put those keys in the habitat mount.
